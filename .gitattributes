# Repository line-ending policy.
# Keep source/config/documentation files deterministic across Windows and Git.
# Windows-native command scripts keep CRLF; source files use LF.

* text=auto

*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.txt      text eol=crlf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.sh       text eol=lf

*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

*.exe      binary
*.dll      binary
*.db       binary
*.sqlite   binary
*.sqlite3  binary
*.pdf      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.zip      binary
